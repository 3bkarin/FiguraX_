# Server Configuration
NODE_ENV=development
PORT=3000

# Frontend Origins (for CORS)
FRONTEND_ORIGIN=http://localhost:5500
PRODUCTION_FRONTEND_ORIGIN=https://your-github-username.github.io/figurax
REVIEW_FRONTEND_ORIGIN=http://127.0.0.1:8080

# Session Security
SESSION_SECRET=your-super-secret-session-key-change-in-production-min-32-chars

# Google Cloud Service Account (for Sheets & Drive)
# Get these from Google Cloud Console > IAM & Admin > Service Accounts
GOOGLE_PROJECT_ID=your-google-project-id
GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Google Sheets
GOOGLE_SHEET_ID=1ssCowPsU-GYSTBrFD093l5eNUvPp5851JuZY7eDLkvA

# Google Drive
GOOGLE_DRIVE_FOLDER_ID=1z1vjxMcmQ2n3ZH32mgi11jTHfOYG6WLm

# Gmail OAuth2 (for sending emails from figuraxverse@gmail.com)
# Get these from Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
GMAIL_CLIENT_ID=your-gmail-oauth-client-id
GMAIL_CLIENT_SECRET=your-gmail-oauth-client-secret
GMAIL_REFRESH_TOKEN=your-gmail-oauth-refresh-token
GMAIL_SENDER=figuraxverse@gmail.com

# Business Email (receives notifications)
COMPANY_EMAIL=figuraxverse@gmail.com

# Currency
DEFAULT_CURRENCY=EGP

